---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Jordan Watt · Game Designer. 20+ years across AAA franchises.' } = Astro.props;
const { pathname } = Astro.url;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);

const nav = [
  { href: '/', label: 'Work' },
  { href: '/about', label: 'About' },
  { href: '/resume', label: 'Resume' },
  { href: '/extras', label: 'Extras' },
];
const year = 2026;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    {/* Mark JS as available before first paint so the motion styles (which start
        content hidden) never leave anything invisible when JS is off. */}
    <script is:inline>document.documentElement.classList.add('js');</script>
    <ClientRouter />
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"></div>
    <header class="site-header">
      <div class="container">
        <a class="brand" href="/">Jordan Watt</a>
        <nav class="nav" aria-label="Primary">
          {nav.map((n) => (
            <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <span>© {year} Jordan Watt · build · play · iterate</span>
        <span class="links">
          <a href="/resume">Resume</a>
          <a href="https://www.linkedin.com/in/jwatt-001/" rel="me noopener" target="_blank">Let's chat</a>
        </span>
      </div>
    </footer>

    <script>
      import { navigate } from 'astro:transitions/client';

      // Runs once (module scripts aren't re-run across view transitions). Reads the
      // live pager links, so ← / → move between projects on any page without
      // re-binding; navigate() gives the same crossfade as a click.
      // Tag the <html> with the navigation direction so the view transition can
      // slide prev/next project moves; any other link clears it (default fade).
      const setDir = (dir?: 'prev' | 'next') => {
        if (dir) document.documentElement.dataset.dir = dir;
        else delete document.documentElement.dataset.dir;
      };
      document.addEventListener(
        'click',
        (e) => {
          const a = (e.target as HTMLElement)?.closest?.('a[href]') as HTMLAnchorElement | null;
          if (!a) return;
          const rel = a.getAttribute('rel');
          setDir(a.classList.contains('pager__link') && (rel === 'prev' || rel === 'next') ? rel : undefined);
        },
        true,
      );

      document.addEventListener('keydown', (e) => {
        if (e.metaKey || e.ctrlKey || e.altKey || e.shiftKey) return;
        const t = e.target as HTMLElement | null;
        if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)) return;
        let href: string | undefined;
        let dir: 'prev' | 'next' | undefined;
        if (e.key === 'ArrowLeft') { href = document.querySelector<HTMLAnchorElement>('.pager a[rel="prev"]')?.href; dir = 'prev'; }
        if (e.key === 'ArrowRight') { href = document.querySelector<HTMLAnchorElement>('.pager a[rel="next"]')?.href; dir = 'next'; }
        if (href) { setDir(dir); navigate(href); }
      });

      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Header state + scroll progress. One listener (window persists across view
      // transitions); reads the live elements, which are swapped per page.
      function onScroll() {
        document.querySelector('.site-header')?.classList.toggle('scrolled', window.scrollY > 40);
        const bar = document.querySelector<HTMLElement>('.scroll-progress');
        if (bar) {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          bar.style.transform = 'scaleX(' + (max > 0 ? Math.min(window.scrollY / max, 1) : 0) + ')';
        }
      }
      window.addEventListener('scroll', onScroll, { passive: true });

      // Re-run on every page (initial load + each view transition).
      function setup() {
        onScroll();
        // Staggered reveal-on-scroll. Stagger resets per intersection batch, so
        // items scrolled to later don't inherit a long global delay.
        const reveals = document.querySelectorAll<HTMLElement>('.reveal:not(.is-visible)');
        if (reduce || !('IntersectionObserver' in window)) {
          reveals.forEach((el) => el.classList.add('is-visible'));
        } else {
          const io = new IntersectionObserver((entries, obs) => {
            let i = 0;
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const el = entry.target as HTMLElement;
              el.style.transitionDelay = i++ * 45 + 'ms';
              el.classList.add('is-visible');
              obs.unobserve(el);
            }
          }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
          reveals.forEach((el) => io.observe(el));
        }

        // Fade images in as they load.
        document.querySelectorAll<HTMLImageElement>('.fadeimg:not(.is-loaded)').forEach((img) => {
          if (img.complete) img.classList.add('is-loaded');
          else img.addEventListener('load', () => img.classList.add('is-loaded'), { once: true });
        });
      }

      document.addEventListener('astro:page-load', setup);
    </script>
  </body>
</html>
